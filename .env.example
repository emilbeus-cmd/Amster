# Required
RESALE_URL=https://example.com/amsterdam-marathon/resale

# Detection rules (set at least one positive rule)
AVAILABLE_SELECTOR=
AVAILABLE_TEXT_REGEX=

# Optional negative rule to suppress false alerts
UNAVAILABLE_TEXT_REGEX=no tickets available|sold out

# Monitor behavior
POLL_INTERVAL_SECONDS=30
PAGE_TIMEOUT_MS=30000
HEADLESS=true
USER_AGENT=

# Optional webhook alert (Slack/Discord/etc)
WEBHOOK_URL=

# Optional email alert
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=
